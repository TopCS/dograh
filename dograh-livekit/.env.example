# dograh-livekit environment variables
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secret_xxxxxxxx
DOGRAH_API_URL=http://api:8000
DOGRAH_INTERNAL_TOKEN=internal-secret-token
GOOGLE_API_KEY=your-google-key
# Vertex AI: path to a GCP service-account JSON (GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project
OPENAI_API_KEY=your-openai-key
DEEPGRAM_API_KEY=your-deepgram-key
CARTESIA_API_KEY=your-cartesia-key
LOG_LEVEL=INFO
